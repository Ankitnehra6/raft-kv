<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.ankitnehra6</groupId>
    <artifactId>raft-kv</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>raft-kv</name>
    <description>A Raft consensus implementation and replicated key-value store, built to be
        deterministically simulation-tested</description>
    <url>https://github.com/Ankitnehra6/raft-kv</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Ankit Nehra</name>
            <url>https://github.com/Ankitnehra6</url>
        </developer>
    </developers>

    <properties>
        <!-- Java 25 is the current LTS. Deliberately no framework: a consensus node has
             no use for dependency injection, and the fewer moving parts between a test
             and the algorithm, the easier the algorithm is to trust. -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <grpc.version>1.84.0</grpc.version>
        <protobuf.version>4.36.1</protobuf.version>

        <junit.version>5.11.4</junit.version>
        <assertj.version>3.27.3</assertj.version>
        <surefire.version>3.5.2</surefire.version>
    </properties>

    <dependencies>
        <!-- gRPC, for the network surface only.
             The consensus core in io.github.ankitnehra6.raftkv.core deliberately depends on
             nothing: it is a pure state machine, and the whole simulation test suite runs
             without any of this on the classpath. These are here so the algorithm can also
             be driven by real sockets. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
        <!-- Required by the generated stubs on a JDK without javax.annotation. -->
        <dependency>
            <groupId>org.apache.tomcat</groupId>
            <artifactId>annotations-api</artifactId>
            <version>6.0.53</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>5.1.8</version>
                <configuration>
                    <protoc>${protobuf.version}</protoc>
                    <plugins>
                        <!-- Generates the service stubs. Without it only the message
                             classes appear, which compile fine and then fail at the first
                             reference to RaftGrpc. -->
                        <plugin kind="binary-maven">
                            <groupId>io.grpc</groupId>
                            <artifactId>protoc-gen-grpc-java</artifactId>
                            <version>${grpc.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
